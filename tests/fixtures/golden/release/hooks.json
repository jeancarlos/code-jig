{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "PYTHONPATH=<HOME>/codex-harness/lib <PY> -P -s -m harness hooks --hook-type codex",
            "commandWindows": "set \"PYTHONPATH=<HOME>/codex-harness/lib\" && \"<PY>\" -P -s -m harness hooks --hook-type codex",
            "statusMessage": "codex-harness watermark",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "PYTHONPATH=<HOME>/codex-harness/lib <PY> -P -s -m harness --codex-home <HOME> collect",
            "commandWindows": "set \"PYTHONPATH=<HOME>/codex-harness/lib\" && \"<PY>\" -P -s -m harness --codex-home \"<HOME>\" collect",
            "statusMessage": "codex-harness collect",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
